<View>

  <!-- IMAGE -->
  <View style="margin-bottom: 20px;">
    <Header value="Image"/>
    <Image name="image" value="$image" maxWidth="400px"/>
    
    <Choices name="image_sarcasm" toName="image" choice="single" showInline="true">
      <Choice value="sarcastic"/>
      <Choice value="non_sarcastic"/>
    </Choices>
  </View>

  <!-- TEXT -->
  <View style="margin-bottom: 20px;">
    <Header value="Text"/>
    <Text name="text" value="$text"/>
    
    <Choices name="text_sarcasm" toName="text" choice="single" showInline="true">
      <Choice value="sarcastic"/>
      <Choice value="non_sarcastic"/>
    </Choices>
  </View>

  <!-- MULTIMODAL -->
  <View style="margin-bottom: 20px;">
    <Header value="Multimodal (Image + Text)"/>
    
    <Choices name="multimodal_sarcasm" toName="text" choice="single" showInline="true">
      <Choice value="sarcastic"/>
      <Choice value="non_sarcastic"/>
    </Choices>
  </View>

  <!-- OPTIONAL: explanation -->
  <TextArea name="explanation" toName="text"
            placeholder="Explain your reasoning (optional)"
            rows="3"/>

</View>